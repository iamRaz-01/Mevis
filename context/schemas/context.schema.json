{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MEVIS Decision Context Schema",
  "type": "object",
  "properties": {
    "context_id": { "type": "string", "pattern": "^ctx_[a-zA-Z0-9_-]+$" },
    "context_type": {
      "type": "string",
      "enum": ["Operational", "Incident", "Medical", "Emergency"]
    },
    "decision_scope": { "type": "string" },
    "version": { "type": "integer" },
    "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
    "freshness": { "type": "number" },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "relevance": { "type": "string", "enum": ["Critical", "High", "Medium", "Low"] }
        },
        "required": ["id", "relevance"]
      }
    }
  },
  "required": [
    "context_id",
    "context_type",
    "decision_scope",
    "version",
    "confidence",
    "freshness",
    "entities"
  ]
}
