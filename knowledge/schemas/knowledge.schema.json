{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MEVIS Knowledge Asset Schema",
  "type": "object",
  "properties": {
    "asset_id": { "type": "string" },
    "title": { "type": "string" },
    "domain": { "type": "string" },
    "content": {
      "type": "object",
      "properties": {
        "summary": { "type": "string" },
        "steps": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "required": ["summary"]
    }
  },
  "required": ["asset_id", "title", "domain", "content"]
}
