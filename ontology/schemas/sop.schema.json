{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SOP",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^sop_[a-zA-Z0-9_-]+$"
    },
    "title": {
      "type": "string"
    },
    "version": {
      "type": "string"
    }
  },
  "required": ["id", "title", "version"],
  "additionalProperties": false
}
