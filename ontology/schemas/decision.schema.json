{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Decision",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^dec_[a-zA-Z0-9_-]+$"
    },
    "operator_id": {
      "type": "string"
    },
    "recommendation_id": {
      "type": "string"
    },
    "action_taken": {
      "type": "string"
    }
  },
  "required": ["id", "operator_id", "recommendation_id", "action_taken"],
  "additionalProperties": false
}
