{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MEVIS Processed Knowledge Object Schema",
  "type": "object",
  "properties": {
    "chunk_id": { "type": "string" },
    "parent_asset_id": { "type": "string" },
    "content_text": { "type": "string" },
    "provenance": {
      "type": "object",
      "properties": {
        "source_document": { "type": "string" },
        "section": { "type": "string" }
      },
      "required": ["source_document"]
    }
  },
  "required": ["chunk_id", "parent_asset_id", "content_text", "provenance"]
}
