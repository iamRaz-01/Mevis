{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Volunteer",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^vol_[a-zA-Z0-9_-]+$"
    },
    "first_name": {
      "type": "string"
    },
    "last_name": {
      "type": "string"
    },
    "role_scope": {
      "type": "string",
      "enum": ["VOLUNTEER"]
    },
    "assigned_gate_id": {
      "type": ["string", "null"]
    },
    "language_preferences": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": ["id", "first_name", "last_name", "role_scope", "language_preferences"],
  "additionalProperties": false
}
