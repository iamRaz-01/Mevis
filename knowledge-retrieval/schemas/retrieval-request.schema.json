{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MEVIS Knowledge Retrieval Request Schema",
  "type": "object",
  "properties": {
    "query_text": { "type": "string" },
    "context_scope": { "type": "string" },
    "filters": {
      "type": "object",
      "properties": {
        "domain": { "type": "string" },
        "min_trust": { "type": "number" }
      },
      "required": ["domain"]
    }
  },
  "required": ["query_text", "context_scope", "filters"]
}
