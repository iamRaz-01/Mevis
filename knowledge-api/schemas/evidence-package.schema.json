{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MEVIS Evidence Package Interface Schema",
  "type": "object",
  "properties": {
    "package_id": { "type": "string" },
    "citations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "chunk_id": { "type": "string" },
          "content_text": { "type": "string" }
        },
        "required": ["chunk_id", "content_text"]
      }
    }
  },
  "required": ["package_id", "citations"]
}
