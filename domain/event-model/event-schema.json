{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MEVIS Event Wrapper Contract",
  "type": "object",
  "properties": {
    "metadata": { "$ref": "metadata-schema.json" },
    "event_type": { "type": "string" },
    "payload": {
      "type": "object",
      "properties": {
        "entity_id": { "type": "string" },
        "state_before": { "type": ["string", "null"] },
        "state_after": { "type": "string" },
        "details": { "type": "object" }
      },
      "required": ["entity_id", "state_after"],
      "additionalProperties": true
    }
  },
  "required": ["metadata", "event_type", "payload"],
  "additionalProperties": false
}
