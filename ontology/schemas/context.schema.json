{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Context",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^ctx_[a-zA-Z0-9_-]+$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "incident_id": {
      "type": "string"
    }
  },
  "required": ["id", "timestamp", "incident_id"],
  "additionalProperties": false
}
