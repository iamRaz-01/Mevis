{
  "name": "mevis-monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Mega Event Volunteer Intelligence System Monorepo",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*",
    "packages/infrastructure/*",
    "packages/platform/*"
  ],
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm test --workspaces --if-present",
    "build": "tsc -b",
    "typecheck": "tsc -b"
  },
  "devDependencies": {
    "eslint": "^9.21.0",
    "prettier": "^3.5.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0",
    "@types/node": "^22.13.4"
  }
}
