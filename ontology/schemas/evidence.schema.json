{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Evidence",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^evd_[a-zA-Z0-9_-]+$"
    },
    "source_type": {
      "type": "string",
      "enum": ["SOP", "RELATIONAL_FACT"]
    },
    "content": {
      "type": "string"
    }
  },
  "required": ["id", "source_type", "content"],
  "additionalProperties": false
}
