{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Task",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^tsk_[a-zA-Z0-9_-]+$"
    },
    "incident_id": {
      "type": "string"
    },
    "assigned_volunteer_id": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": ["Assigned", "Acknowledged", "InProgress", "Completed", "Failed"]
    }
  },
  "required": ["id", "incident_id", "assigned_volunteer_id", "description", "status"],
  "additionalProperties": false
}
