{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Policy",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^pol_[a-zA-Z0-9_-]+$"
    },
    "name": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": ["SAFETY", "AUDIT", "COMPLIANCE"]
    }
  },
  "required": ["id", "name", "type"],
  "additionalProperties": false
}
