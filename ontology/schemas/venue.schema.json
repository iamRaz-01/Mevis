{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Venue",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^ven_[a-zA-Z0-9_-]+$"
    },
    "name": {
      "type": "string"
    },
    "location": {
      "type": "string"
    }
  },
  "required": ["id", "name", "location"],
  "additionalProperties": false
}
