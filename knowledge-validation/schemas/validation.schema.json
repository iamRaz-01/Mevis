{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MEVIS Knowledge Validation Outcome Schema",
  "type": "object",
  "properties": {
    "outcome_id": { "type": "string" },
    "chunk_id": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["Validated", "RequiresReview", "Rejected"]
    },
    "warnings": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "required": ["outcome_id", "chunk_id", "status"]
}
