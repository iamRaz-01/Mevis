{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Coordinator",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^coo_[a-zA-Z0-9_-]+$"
    },
    "station_id": {
      "type": "string"
    }
  },
  "required": ["id", "station_id"],
  "additionalProperties": false
}
