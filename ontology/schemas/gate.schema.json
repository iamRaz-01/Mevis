{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Gate",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^gat_[a-zA-Z0-9_-]+$"
    },
    "zone_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": ["Open", "Restrictive", "Closed"]
    }
  },
  "required": ["id", "zone_id", "status"],
  "additionalProperties": false
}
