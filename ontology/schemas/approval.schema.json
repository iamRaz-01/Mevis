{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Approval",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^app_[a-zA-Z0-9_-]+$"
    },
    "supervisor_id": {
      "type": "string"
    },
    "recommendation_id": {
      "type": "string"
    }
  },
  "required": ["id", "supervisor_id", "recommendation_id"],
  "additionalProperties": false
}
